{
  "uid": "tenants-overview",
  "title": "Tenants overview",
  "description": "Per-tenant ingestion, usage against limits and the health of the tenant gateway. Data comes from the platform tenant.",
  "tags": [
    "platform",
    "tenants"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tenants sending data",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(sum by (user) (rate(cortex_distributor_received_samples_total{user=~\"$tenant\"}[5m])) > 0) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Samples / s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(cortex_distributor_received_samples_total{user=~\"$tenant\"}[5m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In-memory series",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(tenant:memory_series:estimate{user=~\"$tenant\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Gateway success rate (5m)",
      "description": "Share of requests that were not rejected by the gateway and succeeded upstream (client errors excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(tenant_gateway_requests_total{code=~\"2..\"}[5m])) / sum(rate(tenant_gateway_requests_total{code!~\"4..\"}[5m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "-",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Ingestion",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Samples received per tenant",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (user) (rate(cortex_distributor_received_samples_total{user=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{user}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Series usage vs. limit",
      "description": "In-memory series against max_global_series (tenants.yaml). New series are rejected at 100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "tenant:memory_series:estimate{user=~\"$tenant\"} / on (user) tenant:max_global_series_per_user:limit",
          "legendFormat": "{{user}}",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Discarded samples",
      "description": "Samples Mimir refused, e.g. because a tenant hit a limit. Should be empty.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (user, reason) (rate(cortex_discarded_samples_total{user=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{user}} \u00b7 {{reason}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Limits that differ from the defaults",
      "description": "Rendered from tenants/tenants.yaml into Mimir's runtime config.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (user, limit_name) (cortex_limits_overrides{user=~\"$tenant\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "limit_name",
            "rowField": "user",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "user\\limit_name": "Tenant"
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Tenant gateway",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests by token and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (token, code) (rate(tenant_gateway_requests_total[$__rate_interval]))",
          "legendFormat": "{{token}} \u00b7 {{code}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Denied requests by reason",
      "description": "Invalid or missing tokens point to a revoked token still in use, or to probing.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(tenant_gateway_denied_requests_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Latency p99 by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(tenant_gateway_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Token file",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-platform"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "min(tenant_gateway_config_last_reload_successful)",
          "legendFormat": "Last reload OK",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        },
        {
          "expr": "max(tenant_gateway_tokens)",
          "legendFormat": "Tokens loaded",
          "range": false,
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        },
        {
          "expr": "time() - max(tenant_gateway_config_last_reload_success_timestamp_seconds)",
          "legendFormat": "Since last change",
          "range": false,
          "instant": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-platform"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last reload OK"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "rejected",
                        "color": "red"
                      },
                      "1": {
                        "text": "yes",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Since last change"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-platform"
        },
        "query": {
          "query": "label_values(cortex_distributor_received_samples_total, user)",
          "refId": "v"
        },
        "definition": "label_values(cortex_distributor_received_samples_total, user)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Alerts console",
      "type": "link",
      "url": "/d/alerts-console",
      "icon": "bolt"
    },
    {
      "title": "Mimir",
      "type": "dashboards",
      "tags": [
        "mimir"
      ],
      "asDropdown": true
    }
  ]
}
