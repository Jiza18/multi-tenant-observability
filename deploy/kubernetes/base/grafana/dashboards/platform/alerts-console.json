    {
      "id": 4,
      "type": "stat",
      "title": "Tenants with firing alerts",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-all-tenants"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(count by (__tenant_id__) (ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\", __tenant_id__=~\"$tenant\", severity=~\"$severity\"})) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-all-tenants"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Firing alerts",
      "description": "One row per firing alert. 'Firing since' is only known for rules with a `for` clause (ALERTS_FOR_STATE).",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-all-tenants"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "expr": "max by (__tenant_id__, alertname, severity, cluster, namespace, instance) (ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\", __tenant_id__=~\"$tenant\", severity=~\"$severity\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-all-tenants"
          }
        },
        {
          "expr": "max by (__tenant_id__, alertname, severity, cluster, namespace, instance) (ALERTS_FOR_STATE{alertname!~\"Watchdog|InfoInhibitor\", __tenant_id__=~\"$tenant\", severity=~\"$severity\"}) * 1000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-all-tenants"
          }
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Value #A",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ],
            "match": "any",
            "type": "exclude"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "__tenant_id__": 0,
              "severity": 1,
              "alertname": 2,
              "cluster": 3,
              "namespace": 4,
              "instance": 5,
              "Value #B": 6
            },
            "renameByName": {
              "__tenant_id__": "Tenant",
              "severity": "Severity",
              "alertname": "Alert",
              "cluster": "Cluster",
              "namespace": "Namespace",
              "instance": "Instance",
              "Value #B": "Firing since"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Severity"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Firing since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      },
                      "info": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tenant"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Firing alerts by tenant",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-all-tenants"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "count by (__tenant_id__) (ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\", __tenant_id__=~\"$tenant\", severity=~\"$severity\"})",
          "legendFormat": "{{__tenant_id__}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-all-tenants"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "interval": "1m"
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "By severity",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-all-tenants"
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "count by (severity) (ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\", __tenant_id__=~\"$tenant\", severity=~\"$severity\"})",
          "legendFormat": "{{severity}}",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-all-tenants"
          }
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Alert history",
      "description": "When each alert was firing over the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-all-tenants"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "max by (__tenant_id__, alertname) (ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\", __tenant_id__=~\"$tenant\", severity=~\"$severity\"})",
          "legendFormat": "{{__tenant_id__}} \u00b7 {{alertname}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-all-tenants"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "firing",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "interval": "1m"
    },
    {
      "id": 9,
      "type": "row",
      "title": "Alerting pipeline",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "Watchdog per tenant",
      "description": "Watchdog always fires while rules are evaluated for a tenant: by Mimir's ruler for agent tenants, by the tenant's own Prometheus for the others. A tenant missing here has broken rule evaluation or alert forwarding. Notification delivery is checked by routing Watchdog to an external dead man's switch.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-all-tenants"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "max by (__tenant_id__) (ALERTS{alertname=\"Watchdog\", alertstate=\"firing\", __tenant_id__=~\"$tenant\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-all-tenants"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "__tenant_id__": "Tenant",
              "Value": "Watchdog"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-all-tenants"
        },
        "query": {
          "query": "label_values(ALERTS, __tenant_id__)",
          "refId": "v"
        },
        "definition": "label_values(ALERTS, __tenant_id__)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-all-tenants"
        },
        "query": {
          "query": "label_values(ALERTS{__tenant_id__=~\"$tenant\"}, severity)",
          "refId": "v"
        },
        "definition": "label_values(ALERTS{__tenant_id__=~\"$tenant\"}, severity)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Tenants overview",
      "type": "link",
      "url": "/d/tenants-overview",
      "icon": "dashboard"
    }
  ]
}
