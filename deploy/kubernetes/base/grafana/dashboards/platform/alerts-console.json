        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\", __tenant_id__=~\"$tenant\", severity=\"critical\"}) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
